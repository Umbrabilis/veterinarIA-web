{
  "name": "clinica-veterinaria-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:auth\" \"npm:dev:management\" \"npm:dev:shell\"",
    "dev:shell": "vite --config vite.shell.config.ts",
    "dev:auth": "vite --config vite.auth.config.ts --port 5174",
    "dev:management": "vite --config vite.management.config.ts --port 5175",
    "build": "npm run build:shell && npm run build:auth && npm run build:management",
    "build:shell": "tsc -b && vite build --config vite.shell.config.ts",
    "build:auth": "tsc -b && vite build --config vite.auth.config.ts",
    "build:management": "tsc -b && vite build --config vite.management.config.ts",
    "lint": "oxlint",
    "preview": "vite preview --config vite.shell.config.ts",
    "preview:auth": "vite preview --config vite.auth.config.ts --port 5174",
    "preview:management": "vite preview --config vite.management.config.ts --port 5175"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
