FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG APP_TARGET
ARG VITE_API_URL=http://localhost:8080
ARG VITE_AUTH_REMOTE_URL=http://localhost:3000/auth-remote/remoteEntry.js
ARG VITE_MANAGEMENT_REMOTE_URL=http://localhost:3000/management-remote/remoteEntry.js

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_AUTH_REMOTE_URL=${VITE_AUTH_REMOTE_URL}
ENV VITE_MANAGEMENT_REMOTE_URL=${VITE_MANAGEMENT_REMOTE_URL}

RUN npm run build:${APP_TARGET}

FROM nginx:1.27-alpine

ARG APP_TARGET
ARG REMOTE_PATH=.

COPY nginx/shell.conf /tmp/shell.conf
COPY nginx/remote.conf /tmp/remote.conf
RUN if [ "$APP_TARGET" = "shell" ]; then \
      cp /tmp/shell.conf /etc/nginx/conf.d/default.conf; \
    else \
      cp /tmp/remote.conf /etc/nginx/conf.d/default.conf; \
    fi \
    && rm /tmp/shell.conf /tmp/remote.conf

COPY --from=build /app/dist/${APP_TARGET}/ /usr/share/nginx/html/${REMOTE_PATH}/

EXPOSE 80
